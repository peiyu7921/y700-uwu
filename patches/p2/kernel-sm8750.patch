diff --git a/arch/arm64/Kbuild b/arch/arm64/Kbuild
index e4847ba..1540768 100644
--- a/arch/arm64/Kbuild
+++ b/arch/arm64/Kbuild
@@ -3,7 +3,16 @@ obj-y			+= kernel/ mm/ net/
 obj-$(CONFIG_KVM)	+= kvm/
 obj-$(CONFIG_XEN)	+= xen/
 obj-$(subst m,y,$(CONFIG_HYPERV))	+= hyperv/
-obj-$(CONFIG_GUNYAH)	+= gunyah/
+# sm8750-gunyah-kbuild-only: gunyah/ is built by the external_modules entry
+#   "sm8750/arch/arm64/gunyah:kbuild"
+# (the bazel build uses a separate ddk_module for it). Letting the in-tree descend
+# compile it as well installs gh_arm_drv.ko twice — once under kernel/ and once
+# under updates/ — and the kernel_modules flattening step aborts with
+#   duplicate kernel module gh_arm_drv.ko
+# Gunyah's gunyah_hypercall.c / timer.c live in the GKI common tree, not here, so
+# dropping this descend compiles nothing less.
+# obj-$(CONFIG_GUNYAH)	+= gunyah/
+
 obj-$(CONFIG_CRYPTO)	+= crypto/
 
 # for cleaning
