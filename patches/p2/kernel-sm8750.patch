diff --git a/drivers/soc/qcom/mpam/Makefile b/drivers/soc/qcom/mpam/Makefile
index 1d7b99f..a2e3335 100644
--- a/drivers/soc/qcom/mpam/Makefile
+++ b/drivers/soc/qcom/mpam/Makefile
@@ -3,7 +3,11 @@
 ccflags-y += -I$(src)
 
 obj-$(CONFIG_QTI_MPAM) += mpam.o
-mpam-objs += mpam.o mpam_rpmsg.o
+# sm8750-mpam-fix: mpam.ko is a composite of mpam.c + mpam_rpmsg.c (see modules.bzl srcs).
+# mpam.c holds module_init/MODULE_LICENSE so it must be linked in; a kbuild composite
+# target cannot be named after one of its own sources (that is the circular ld error),
+# so the main source is mpam_main.c.
+mpam-objs += mpam_main.o mpam_rpmsg.o
 
 obj-$(CONFIG_QTI_CPU_MPAM_INTERFACE) += cpu_mpam.o
 
