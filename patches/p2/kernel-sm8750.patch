+	 * 详见 scripts/fix-gendwarfksyms-libdw.py。
+	 */
+	if (dwarf_getsrcfiles(&cudie, &files, NULL)) {
+		s = dwarf_diename(&cudie);
+		if (!s)
+			s = "";
+		s = strrchr(s, '.');
+		res = s && !strcmp(s, ".c");
+		cache_set(&srcfile_cache, filenum, res);
+		return !!res;
+	}
 
 	s = dwarf_filesrc(files, filenum, NULL, NULL);
 	if (!s)
