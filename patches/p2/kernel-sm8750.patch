diff --git a/drivers/Makefile b/drivers/Makefile
index c385cb2..a30def5 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -1,3 +1,11 @@
+# sm8750-vendorinc-fix: vendor headers live under include/ and include/linux/
+# Only the *_/include/linux_* root and the cross-tree vendor roots: adding
+# -idirafter for a dir that is ALREADY a -I dir (same include/ root) makes clang
+# treat it as a system dir and changes <linux/types.h> resolution
+# (empirical: unknown type name 'bool' in kasan-checks.h).
+subdir-ccflags-y += -idirafter $(abs_srctree)/include/linux
+subdir-ccflags-y += -idirafter $(srctree)/../vendor/lenovo/sm8750/include
+subdir-ccflags-y += -idirafter $(srctree)/../vendor/lenovo/sm8750/include/linux
 # SPDX-License-Identifier: GPL-2.0
 
 
