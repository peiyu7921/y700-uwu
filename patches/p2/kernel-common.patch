diff --git a/rust/Makefile b/rust/Makefile
index 1d77357fedfd..6a8566023736 100644
--- a/rust/Makefile
+++ b/rust/Makefile
@@ -304,7 +304,15 @@ endif
 # prototypes for functions like `memcpy` -- if this flag is not passed,
 # `bindgen`-generated prototypes use `c_ulong` or `c_uint` depending on
 # architecture instead of generating `usize`.
-bindgen_c_flags_final = $(bindgen_c_flags_lto) -fno-builtin -D__BINDGEN__
+# sm8750-bindgen-skip-cflags: 在汇聚点剔除两项。Clang 分支（CONFIG_CC_IS_CLANG=y，本树即是）的
+#     bindgen_c_flags = $(c_flags)
+# 是直接透传、不经过 bindgen_skip_c_flags 的，所以跳过项只在 else(GCC)
+# 分支里加，对本树无效。这两项由 scripts/Makefile.extrawarn 的
+# cc-disable-warning 按 clang 22 探测展开，而 bindgen 的 libclang 是
+# LLVM 20（见 scripts/fix-bindgen-libclang.py），不认识它们；KBUILD_CFLAGS
+# 带 -Werror，告警于是变成错误、bindgen 放弃生成。两者只是告警开关，
+# 剔掉不影响生成的绑定内容。filter-out 按词精确匹配且幂等。
+bindgen_c_flags_final = $(filter-out -Wno-default-const-init-unsafe -Wno-unterminated-string-initialization,$(bindgen_c_flags_lto)) -fno-builtin -D__BINDGEN__
 
 # Each `bindgen` release may upgrade the list of Rust target versions. By
 # default, the highest stable release in their list is used. Thus we need to set
