diff --git a/modules.include.system_dlkm b/modules.include.system_dlkm
new file mode 100644
index 0000000..cf94182
--- /dev/null
+++ b/modules.include.system_dlkm
@@ -0,0 +1,16 @@
+# sm8750-system-dlkm: system_dlkm 分区的模块清单。
+#
+# 这 6 个是 GKI 通用模块，参考版 OTA 的 system_dlkm 里也有同名模块；
+# 在本树它们此前「编出来了但没进任何清单」，等于白编。
+# 顺序即 insmod 顺序，pstore_blk 依赖 pstore_zone 故后者在前。
+#
+# 参考版该分区共 90 个模块，其余 84 个本树未编出 —— 根因在内核配置
+# （CONFIG_ZRAM is not set、CONFIG_ZSMALLOC 未设置等），不是清单问题。
+# 详见 scripts/add-system-dlkm-lists.py。
+
+aes-neon-blk.ko
+efivarfs.ko
+netfs.ko
+pstore_zone.ko
+pstore_blk.ko
+virtio_console.ko
