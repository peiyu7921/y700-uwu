+# sm8750-vendorinc-first: 这些头文件在 common/include 与 vendor/include 里同名且共用同一个
+# include guard，但 common 版是瘦身 GKI 版（如 llcc-qcom.h 缺 LLCC_VIDDEC），
+# 先命中的赢。subdir-ccflags-y 只能追加，改不了顺序，故在 LINUXINCLUDE 上前置。
+LINUXINCLUDE := -I$(srctree)/../vendor/lenovo/sm8750/include $(LINUXINCLUDE)
+# sm8750-vendorinc: vendor headers (<dt-bindings/...>, <linux/soc/qcom/...>,
+# <soc/qcom/...>) all live under sm8750/include
+subdir-ccflags-y += -I$(srctree)/../vendor/lenovo/sm8750/include
+subdir-ccflags-y += -I$(srctree)/../vendor/lenovo/sm8750/include/linux
+# sm8750-hw-fence-include: kgsl_sync.c:215 会 #include <msm_hw_fence.h>，该头属于**另一个模块**
+# mm-drivers/hw_fence/include/（上游 bazel 里是跨 ddk_module 依赖，
+# kbuild 侧必须显式 -I）。用 $(srctree) 定位，与上面两条 vendor include 同风格。
+subdir-ccflags-y += -I$(srctree)/../vendor/lenovo/sm8750-modules/qcom/opensource/mm-drivers/hw_fence/include
 # SPDX-License-Identifier: GPL-2.0-only
 
+# sm8750-kernel-src: 本模块走 external_modules 的 ":kbuild" 分支，而 kernel.go 那个分支
+# 只注入 KCPPFLAGS，**不传 KERNEL_SRC**（只有 ":all"/":modules" 分支才传）。
+# 而 Kbuild 第 96 行的 ccflags 用了 -I$(KERNEL_SRC)/drivers/devfreq，
+# 未定义时展开成 -I/drivers/devfreq，导致 governor.h 找不到。
+# srctree 在 M= 模式下已确认指向 GKI common 树，正是该头所在处；
+# 用 ?= 以免覆盖外部传入的值。
+KERNEL_SRC ?= $(srctree)
