index c8228fe..b69f4eb 100644
--- a/device.mk
+++ b/device.mk
@@ -6,6 +6,10 @@
 # Add common definitions for Qualcomm
 $(call inherit-product, hardware/qcom-caf/common/common.mk)
 
+# Kernel (uwu_kernel, declared in kernel.bp and wired up in BoardConfig.mk)
+PRODUCT_PACKAGES += \
+    kernel
+
 # A/B
 $(call inherit-product, $(SRC_TARGET_DIR)/product/virtual_ab_ota/vabc_features.mk)
 
@@ -182,9 +186,16 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     vendor.lineage.health-service.default
 
-$(call soong_config_set,lineage_health,charging_control_charging_path,/sys/class/power_supply/battery/battery_maintenance20)
-$(call soong_config_set,lineage_health,charging_control_charging_enabled,0)
-$(call soong_config_set,lineage_health,charging_control_charging_disabled,1)
+# Charging control
+#
+# battery_maintenance20 exposes POWER_SUPPLY_PROP_BATTERY_MAINTENANCE20, i.e. Lenovo's
+# "battery care at 20%" limiter. It is not a charge switch, so wiring it up here made the
+# charging control (and bypass charging) a no-op. The real toggle is charging_enable
+# (POWER_SUPPLY_PROP_BATTERY_CHARGING_ENABLE): 1 = charging allowed, 0 = charging
+# suspended while the device keeps running off the adapter (bypass charging).
+$(call soong_config_set,lineage_health,charging_control_charging_path,/sys/class/power_supply/battery/charging_enable)
+$(call soong_config_set,lineage_health,charging_control_charging_enabled,1)
+$(call soong_config_set,lineage_health,charging_control_charging_disabled,0)
 
 # Media
 PRODUCT_PACKAGES += \
@@ -244,6 +255,10 @@ PRODUCT_SOONG_NAMESPACES += \
 # Storage
 $(call inherit-product, $(SRC_TARGET_DIR)/product/emulated_storage.mk)
 
+# Power
+PRODUCT_PACKAGES += \
+    EldenPowerSettings
+
 # Touch
 PRODUCT_PACKAGES += \
     EldenTouchSettings \
