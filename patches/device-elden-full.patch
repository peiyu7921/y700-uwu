+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="org.lineageos.elden.powersettings">
+
+    <application
+        android:label="@string/power_settings_title"
+        android:supportsRtl="true"
+        android:theme="@style/Theme.EldenPowerSettings">
+        <activity
+            android:name=".PowerSettingsActivity"
+            android:exported="false"
+            android:label="@string/power_settings_title">
+            <intent-filter>
+                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <meta-data
+                android:name="com.android.settings.category"
+                android:value="com.android.settings.category.ia.battery" />
+            <meta-data
+                android:name="com.android.settings.profile"
+                android:value="primary_profile_only" />
+        </activity>
+    </application>
+</manifest>
