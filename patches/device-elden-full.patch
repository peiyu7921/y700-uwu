diff --git a/BoardConfig.mk b/BoardConfig.mk
index 614aefe..dba83f6 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -49,6 +49,8 @@ TARGET_SCREEN_DENSITY := 440
 
 # DTB / DTBO
 BOARD_INCLUDE_DTB_IN_BOOTIMG := true
+# DTB/DTBO taken from the running device. The Qualcomm sun devicetrees cannot be
+# built from the GKI common tree with plain Kbuild.
 BOARD_KERNEL_SEPARATED_DTBO := true
 
 # Filesystem
@@ -78,18 +80,15 @@ BOARD_BOOTCONFIG := \
     androidboot.vendor.qspa=true \
     androidboot.serialconsole=0
 
-TARGET_KERNEL_PLATFORM_TARGET := sun_perf
-TARGET_KERNEL_SOURCE := vendor/lenovo/sm8750
-TARGET_KERNEL_UNSAFE_DDK_HEADERS := true
-TARGET_KERNEL_VERSION := 6.12
+# uwu_kernel (Soong-based kernel build)
+#
+# The Sun tree is a kleaf/DDK multi-repo layout; it is consumed through Kbuild by the
+# uwu_kernel module declared in kernel.bp. Module install/load lists live in
+# modules.include.* / modules.load.* on the device tree.
+# See https://uwuaosp.uwuniverse.org/docs/soong-only/uwu_kernel/
+BOARD_USES_SOONG_KERNEL := true
+SOONG_KERNEL_MODULE := //device/lenovo/elden:kernel
 
-# Kernel modules
-BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST_FILE := $(DEVICE_PATH)/modules.blocklist
-BOARD_VENDOR_KERNEL_MODULES_LOAD := $(strip $(shell cat $(DEVICE_PATH)/modules.load.vendor_dlkm))
-BOARD_VENDOR_RAMDISK_KERNEL_MODULES_BLOCKLIST_FILE := $(BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST_FILE)
-BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD := $(strip $(shell cat $(DEVICE_PATH)/modules.load))
-BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD := $(strip $(shell cat $(DEVICE_PATH)/modules.load.recovery))
-BOOT_KERNEL_MODULES := $(BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD)
 
 # Metadata
 BOARD_USES_METADATA_PARTITION := true
@@ -203,3 +202,13 @@ WPA_SUPPLICANT_VERSION := VER_0_8_X
 
 # Include the proprietary files BoardConfig.
 include vendor/lenovo/elden/BoardConfigVendor.mk
+
+# Vendor kernel UAPI headers.
+#
+# The CAF audio/display/ipa/graphics userspace includes Qualcomm DDK UAPI (linux/msm_audio.h
+# etc). uwu_kernel only runs Kbuild headers_install on kernel_dir (the GKI common tree), so
+# those headers have to be supplied through DeviceKernelHeaderDirs(). config.mk requires each
+# entry to end in "kernel-headers", so scripts/gen-kernel-headers.sh aggregates the DDK UAPI
+# into device/lenovo/elden/kernel-headers.
+TARGET_BOARD_KERNEL_HEADERS := device/lenovo/elden/kernel-headers
+BUILD_BROKEN_SRC_DIR_IS_WRITABLE := true
