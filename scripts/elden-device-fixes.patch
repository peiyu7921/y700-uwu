diff --git a/power/src/org/lineageos/elden/powersettings/PowerSettingsActivity.java b/power/src/org/lineageos/elden/powersettings/PowerSettingsActivity.java
new file mode 100644
index 0000000..90e41f9
--- /dev/null
+++ b/power/src/org/lineageos/elden/powersettings/PowerSettingsActivity.java
@@ -0,0 +1,76 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.elden.powersettings;
+
+import android.os.Bundle;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Log;
+
+import androidx.preference.PreferenceFragmentCompat;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settingslib.collapsingtoolbar.CollapsingToolbarBaseActivity;
+
+import vendor.lineage.health.IChargingControl;
+
+public class PowerSettingsActivity extends CollapsingToolbarBaseActivity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (savedInstanceState == null) {
+            getSupportFragmentManager().beginTransaction()
+                    .replace(com.android.settingslib.collapsingtoolbar.R.id.content_frame,
+                            new PowerSettingsFragment())
+                    .commit();
+        }
+    }
+
+    public static class PowerSettingsFragment extends PreferenceFragmentCompat {
+        private static final String TAG = "EldenPowerSettings";
+        private static final String KEY_BYPASS = "elden_charging_bypass";
+
+        private IChargingControl mChargingControl;
+        private SwitchPreferenceCompat mBypass;
+
+        @Override
+        public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+            setPreferencesFromResource(R.xml.power_settings, null);
+
+            mBypass = findPreference(KEY_BYPASS);
+            if (mBypass == null) {
+                return;
+            }
+
+            mChargingControl = IChargingControl.Stub.asInterface(
+                    ServiceManager.waitForDeclaredService(
+                            IChargingControl.DESCRIPTOR + "/default"));
+            if (mChargingControl == null) {
+                Log.w(TAG, "vendor.lineage.health is not available");
+                mBypass.setEnabled(false);
+                mBypass.setSummary(R.string.charging_bypass_unavailable);
+                return;
+            }
+
+            try {
+                mBypass.setChecked(!mChargingControl.getChargingEnabled());
+            } catch (RemoteException e) {
+                Log.e(TAG, "Unable to read charging state", e);
+            }
+
+            mBypass.setOnPreferenceChangeListener((preference, newValue) -> {
+                boolean bypass = (Boolean) newValue;
+                try {
+                    mChargingControl.setChargingEnabled(!bypass);
+                    return true;
+                } catch (RemoteException e) {
+                    Log.e(TAG, "Unable to toggle charging", e);
+                    return false;
+                }
+            });
+        }
+    }
+}
diff --git a/sepolicy/vendor/hal_lineage_health_default.te b/sepolicy/vendor/hal_lineage_health_default.te
new file mode 100644
index 0000000..03d9774
--- /dev/null
+++ b/sepolicy/vendor/hal_lineage_health_default.te
@@ -0,0 +1,7 @@
+# vendor.lineage.health charging control
+#
+# The HAL toggles /sys/class/power_supply/battery/charging_enable, which lives under the
+# battery power supply node tagged sysfs_battery_supply. device/lineage/sepolicy already
+# grants rw_dir_file() on it; this is kept explicit so the dependency is visible from the
+# device tree and survives any upstream reorganisation of those common rules.
+allow hal_lineage_health_default sysfs_battery_supply:file rw_file_perms;
