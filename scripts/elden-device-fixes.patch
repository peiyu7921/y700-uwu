 power/Android.bp                              | 18 +++++
 power/AndroidManifest.xml                     | 25 ++++++
 power/res/values/strings.xml                  |  7 ++
 power/res/values/styles.xml                   | 10 +++
 power/res/xml/power_settings.xml              |  9 +++
 .../powersettings/PowerSettingsActivity.java  | 76 +++++++++++++++++++
 sepolicy/vendor/hal_lineage_health_default.te |  7 ++
 uwu_elden.mk                                  |  2 +
 10 files changed, 188 insertions(+), 3 deletions(-)
 create mode 100644 power/Android.bp
