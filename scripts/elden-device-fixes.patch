diff --git a/device.mk b/device.mk
index c8228fe..eda7177 100644
--- a/device.mk
+++ b/device.mk
@@ -182,9 +182,17 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     vendor.lineage.health-service.default
 
-$(call soong_config_set,lineage_health,charging_control_charging_path,/sys/class/power_supply/battery/battery_maintenance20)
-$(call soong_config_set,lineage_health,charging_control_charging_enabled,0)
-$(call soong_config_set,lineage_health,charging_control_charging_disabled,1)
+# Charging control
+#
+# battery_maintenance20 exposes POWER_SUPPLY_PROP_BATTERY_MAINTENANCE20, i.e. Lenovo's
+# "battery care at 20%" limiter. It is not a charge switch, so wiring it up here made the
+# charging control (and bypass charging) a no-op. The real toggle is charging_enable
+# (POWER_SUPPLY_PROP_BATTERY_CHARGING_ENABLE): 1 = charging allowed, 0 = charging
+# suspended while the device keeps running off the adapter (bypass charging).
+$(call soong_config_set,lineage_health,charging_control_charging_path,/sys/class/power_supply/battery/charging_enable)
+$(call soong_config_set,lineage_health,charging_control_charging_enabled,1)
+$(call soong_config_set,lineage_health,charging_control_charging_disabled,0)
+$(call soong_config_set,lineage_health,charging_control_supports_bypass,true)
 
 # Media
 PRODUCT_PACKAGES += \
@@ -244,6 +252,10 @@ PRODUCT_SOONG_NAMESPACES += \
 # Storage
 $(call inherit-product, $(SRC_TARGET_DIR)/product/emulated_storage.mk)
 
+# Power
+PRODUCT_PACKAGES += \
+    EldenPowerSettings
+
 # Touch
 PRODUCT_PACKAGES += \
     EldenTouchSettings \
diff --git a/init/ueventd.qcom.rc b/init/ueventd.qcom.rc
index 96f54ec..5c4f640 100644
--- a/init/ueventd.qcom.rc
+++ b/init/ueventd.qcom.rc
@@ -60,6 +60,8 @@
 
 # Battery
 /sys/class/power_supply/battery battery_maintenance20 0660 system system
+# charging_enable is the real charge switch consumed by vendor.lineage.health
+/sys/class/power_supply/battery charging_enable    0660 system system
 
 
 # Firmware directory Path
@@ -459,6 +461,23 @@ subsystem mem_buf_vm
 /sys/class/leds/blue     repeat       0640    system    system
 /sys/class/leds/blue     hw_pattern   0640    system    system
 
+# Camera flash / torch LEDs (PM8550). camx drives these through cam_flash ioctls in
+# kernel space, but expose them writable as well so the LED nodes are usable from
+# userspace (torch strength, vendor tooling) instead of staying root-only.
+/sys/class/leds/led:torch_0    brightness     0660    system    system
+/sys/class/leds/led:torch_1    brightness     0660    system    system
+/sys/class/leds/led:torch_2    brightness     0660    system    system
+/sys/class/leds/led:torch_3    brightness     0660    system    system
+/sys/class/leds/led:flash_0    brightness     0660    system    system
+/sys/class/leds/led:flash_1    brightness     0660    system    system
+/sys/class/leds/led:flash_2    brightness     0660    system    system
+/sys/class/leds/led:flash_3    brightness     0660    system    system
+/sys/class/leds/led:flash_0    flash_strobe   0660    system    system
+/sys/class/leds/led:flash_1    flash_strobe   0660    system    system
+/sys/class/leds/led:flash_2    flash_strobe   0660    system    system
+/sys/class/leds/led:flash_3    flash_strobe   0660    system    system
+/sys/class/leds/led:switch_2   brightness     0660    system    system
+
 #Haptics class devices
 /sys/class/qcom-haptics    visense_enabled     0400    system    system
 /sys/class/qcom-haptics    primitive_duration  0600    system    system
