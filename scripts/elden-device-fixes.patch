index 93682c2..30f1800 100644
--- a/uwu_elden.mk
+++ b/uwu_elden.mk
@@ -13,6 +13,8 @@ $(call inherit-product, device/lenovo/elden/device.mk)
 # Inherit some common uwuAOSP stuff.
 UWU_DEVICE_TYPE := tablet
 UWU_SUPPORTS_TELEPHONY := false
+# Ship without Google apps: vendor/uwu/config/pixel.mk only pulls in GMS when this is true.
+WITH_GAPPS := false
 $(call inherit-product, vendor/uwu/config/common.mk)
 
 PRODUCT_NAME := uwu_elden
