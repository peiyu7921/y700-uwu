# ============================================================
# 排除：外部源码树与子仓库
# ============================================================
# 每个子目录都是独立的 git 仓库（各自有 remote），不应嵌套进顶层仓库。
# 需要它们时按 README 里的 repo sync / clone 流程拉取。
android_device_lenovo_elden/
android_kernel_lenovo_sm8750/
android_kernel_lenovo_sm8750-devicetrees/
android_kernel_lenovo_sm8750-modules/
platform_vendor_uwu/
proprietary_vendor_lenovo_elden/
elden-kernel/

# AOSP 树（repo sync 产物，只有 .repo 占位）
/aosp/

# ============================================================
# 排除：大体积二进制
# ============================================================
# 10 GB / 1 GB 的测试镜像，绝不进仓库
*.img
*.bin
*.iso
*.zip
*.tar.gz

# 预编译设备树（129 M，二进制）
/prebuilt_dtb/

# Docker 镜像里落盘的 JDK 安装包（124 M）
/docker/jdk/

# ============================================================
# 排除：本地机密
# ============================================================
# 脱敏映射表保存真实的服务器地址/资产 ID，只留在本机。
# 模板见 scripts/sanitize-secrets.py --emit-template
/config/secrets.map
/config/local.env

# ============================================================
# 排除：构建与运行产物
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.log
*.rc
/out/

# ============================================================
# 排除：编辑器与系统文件
# ============================================================
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Reasonix 会话状态
/.reasonix/
